{
  "name": "tally-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "rm -rf dist && tsc && cp -r src/db/migrations dist/db/",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "DATABASE_URL=postgres://tally:tally@localhost:55432/tally_test vitest run",
    "test:all": "pnpm test && pnpm test:pg"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "csv-parse": "7.0.1",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "express-rate-limit": "8.5.2",
    "multer": "2.2.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/multer": "2.1.0",
    "@types/node": "25.9.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.1",
    "supertest": "7.2.2",
    "tsx": "4.22.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
