{
  "name": "tally",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"pnpm -C server dev\" \"pnpm -C client dev\"",
    "build": "pnpm -C server build && pnpm -C client build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "concurrently": "9.2.1",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0"
  }
}
